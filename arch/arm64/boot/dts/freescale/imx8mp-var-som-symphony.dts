/*BEGIN: UART Console*/
/* Configuración de la consola UART2 */
&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart2>;
	status = "okay";
};
/*END: UART Console*/

/*BEGIN: Ethernet PHY*/
&eqos {
	mdio {
		ethphy0: ethernet-phy@4 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <4>;
			phy-mode = "rgmii-id";
			adi,rx-internal-delay-ps = <1800>;
			adi,tx-internal-delay-ps = <2200>;
			reset-gpios = <&gpio5 16 GPIO_ACTIVE_LOW>;
			reset-assert-us = <10000>;
			reset-deassert-us = <20000>;
			vddio-supply = <&vddio1>;

			vddio1: vddio-regulator {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};
		};

		ethphy1: ethernet-phy@10 {
			compatible = "ethernet-phy-ieee802.3-c22";
			reg = <10>;
			phy-mode = "rgmii-id";
			adi,rx-internal-delay-ps = <1800>;
			adi,tx-internal-delay-ps = <2200>;
			reset-gpios = <&gpio5 17 GPIO_ACTIVE_LOW>;
			reset-assert-us = <10000>;
			reset-deassert-us = <20000>;
			vddio-supply = <&vddio2>;

			vddio2: vddio-regulator {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};
		};
	};
};

&fec {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fec>;
	phy-mode = "rgmii";
	phy-handle = <&ethphy0>;
	phy-supply = <&reg_fec_phy>;
	status = "okay";
};
/*END: Ethernet PHY*/

/* BEGIN: Configuración del bus I2C3 */
&i2c3 {
	clock-frequency = <400000>;							// Velocidad del bus I2C (400 kHz)
	pinctrl-names = "default", "gpio";
	pinctrl-0 = <&pinctrl_i2c3>;
	pinctrl-1 = <&pinctrl_i2c3_gpio>;
	scl-gpios = <&gpio5 18 GPIO_ACTIVE_HIGH>;			// GPIO para la línea de reloj (SCL)
	sda-gpios = <&gpio5 19 GPIO_ACTIVE_HIGH>;			// GPIO para la línea de datos (SDA)
	status = "okay";

	/* USB Type-C Controller */ //Esto es la negociacion del modo de USB. ES un chip I2C.
	typec@3d {
		compatible = "nxp,ptn5150";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_extcon>;
		reg = <0x3d>;
		interrupt-parent = <&gpio1>;
		interrupts = <5 IRQ_TYPE_LEVEL_HIGH>;
		irq-is-id-quirk;
		status ="okay";
		
		/* Puertos de la interfaz Type-C */
		port {
			typec_dr_sw: endpoint {
				remote-endpoint = <&usb3_drd_sw>;		// Vincula este endpoint con el controlador DRD USB3
			};
		};
	};
	
	/* GPIO para la selección de USB3 */
	usb3_sel_hog {
		gpio-hog;									// El GPIO es "hogged", significa que lo controla el kernel directamente
		gpios = <4 0>;
		output-low;
		line-name = "usb3_sel";
	};
};


&i2c4 {
	clock-frequency = <400000>;
	pinctrl-names = "default", "gpio";
	pinctrl-0 = <&pinctrl_i2c4>;
	pinctrl-1 = <&pinctrl_i2c4_gpio>;
	scl-gpios = <&gpio5 20 GPIO_ACTIVE_HIGH>;
	sda-gpios = <&gpio5 21 GPIO_ACTIVE_HIGH>;
	status = "okay";

	/* DS1337 RTC module */
	rtc@68 {
		compatible = "dallas,ds1337";
		reg = <0x68>;
		status = "okay";
	};
};

