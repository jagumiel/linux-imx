#include "imx8mp-var-som.dtsi"

/ {
	model = "Variscite VAR-SOM-MX8M-PLUS on Symphony-Board";

	// Configuración de la consola de salida (UART2)
	chosen {
		stdout-path = &uart2;
	};

	// Reloj de referencia para el PCIe 0
	pcie0_refclk: pcie0-refclk {
		compatible = "fixed-clock";					// Reloj fijo para PCIe 0
		#clock-cells = <0>;
		clock-frequency = <100000000>;				// Frecuencia del reloj a 100 MHz
	};

	// Regulador para la alimentación del controlador USDHC2 (3.3V)
	reg_usdhc2_vmmc: regulator-usdhc2-vmmc {
		compatible = "regulator-fixed";				// Regulador fijo
		regulator-name = "VSD_3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio4 22 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <100>;
		off-on-delay-us = <12000>;
	};

	// Regulador ajustable para VQMMC del controlador USDHC2
	reg_usdhc2_vqmmc: regulator-usdhc2-vqmmc {
		compatible = "regulator-gpio";				// Regulador controlado por GPIO
		regulator-name = "VSD_VSEL";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio2 12 GPIO_ACTIVE_HIGH>;
		gpios-states = <1>;
		states = <3300000 0
			  1800000 1>;
	};

	// Regulador para la alimentación del PHY Ethernet (3.3V)
	reg_fec_phy_vsel: regulator-fec-phy-vsel {
		compatible = "regulator-fixed";				// Regulador fijo
		regulator-name = "fec-phy-vsel";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		//gpio = <&pca9534 6 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	// Regulador para el PHY Ethernet (1.8V)
	reg_fec_phy: regulator-fec-phy {
		compatible = "regulator-fixed";
		regulator-name = "fec-phy";
		vin-supply = <&reg_fec_phy_vsel>;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-enable-ramp-delay = <20000>;
		//gpio = <&pca9534 7 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
	};

	// Configuración de sonido HDMI (deshabilitada)
	sound_hdmi: sound_hdmi {
		compatible = "fsl,imx-audio-hdmi";
		model = "audio-hdmi";
		audio-cpu = <&aud2htx>;
		hdmi-out;
		constraint-rate = <44100>, // Tasa de muestreo soportada (44.1 kHz, 88.2 kHz, 176.4 kHz, 32 kHz, 48 kHz, 96 kHz, 192 kHz)
				<88200>,
				<176400>,
				<32000>,
				<48000>,
				<96000>,
				<192000>;
		status = "disabled";
	};
	
	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_leds>;		// Asocia el grupo de pines "ledsgrp" al nodo de LEDs
		status = "okay";

		led1: led_1 {
			label = "POWER_LED_TOP_R";
			gpios = <&gpio5 3 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led2: led_2 {
			label = "POWER_LED_TOP_G";
			gpios = <&gpio1 13 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led3: led_3 {
			label = "LED_WAN1";
			gpios = <&gpio1 15 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led4: led_4 {
			label = "LED_WAN2";
			gpios = <&gpio5 2 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led5: led_5 {
			label = "LED_LAN";
			gpios = <&gpio4 27 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		led6: led_6 {
			label = "LED_LAN_LOCAL";
			gpios = <&gpio4 19 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};
	};
	
