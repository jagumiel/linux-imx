&isi_0 {
	status = "okay";

	cap_device {
		status = "disabled";
	};

	m2m_device {
		status = "okay";
	};
};

&isi_1 {
	status = "disabled";
};

&ecspi2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_ecspi2>;
	cs-gpios = <&gpio5 13 GPIO_ACTIVE_LOW>;
	status = "okay";

	spidev@0 {
		compatible = "var,spidev";
		reg = <0>;
		spi-max-frequency = <12000000>;
		status = "okay";
	};
};

&gpio1 {
	cam_buf_hog {
		gpio-hog;
		gpios = <6 0>;
		output-low;
		line-name = "cam_buf";
	};
};

&iomuxc {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_hog>;

	pinctrl_hog: hoggrp {
		fsl,pins = <
			MX8MP_IOMUXC_I2C1_SCL__GPIO5_IO14					0x00	//Agrego esto para los reset de Ethernet USB.
			MX8MP_IOMUXC_I2C1_SDA__GPIO5_IO15					0x00	//Agrego esto para los reset de Ethernet USB.
			MX8MP_IOMUXC_I2C2_SCL__GPIO5_IO16					0x00	//Agrego esto para los reset de Ethernet.
			MX8MP_IOMUXC_I2C2_SDA__GPIO5_IO17					0x00	//Agrego esto para los reset de Ethernet.
		>;
	};

	pinctrl_pwm1: pwm1grp {
		fsl,pins = <
			MX8MP_IOMUXC_SPDIF_EXT_CLK__PWM1_OUT				0x116
		>;
	};
	
